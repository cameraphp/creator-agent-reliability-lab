# LOCAL, THROWAWAY, NON-PRODUCTION settings for the lab's own Docker Postgres.
# These are not secrets. Do not reuse them anywhere. Copying to .env is optional:
# the same values are the built-in defaults in src/config.ts.
LAB_PG_HOST=127.0.0.1
LAB_PG_PORT=55439
LAB_DB_NAME=creator_lab
LAB_TEST_DB_NAME=creator_lab_test
LAB_EVAL_DB_NAME=creator_lab_eval
LAB_ADMIN_USER=lab_admin
LAB_ADMIN_PASSWORD=lab_admin_local_only
LAB_APP_PASSWORD=lab_app_local_only
LAB_WORKER_PASSWORD=lab_worker_local_only
LAB_API_PORT=38471
# Optional overrides used by smoke tests (milliseconds of real wall-clock time).
# LAB_LEASE_MS=30000
